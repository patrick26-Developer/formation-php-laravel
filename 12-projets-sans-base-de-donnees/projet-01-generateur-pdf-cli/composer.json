{
    "name": "formation-php-laravel/generateur-pdf-cli",
    "description": "Générateur de rapports PDF en ligne de commande, sans base de données.",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    }
}
